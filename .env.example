# ==============================================================================
# Personal Algo-Trading Bot — Environment Variables Configuration Template
# คำเตือน: ห้าม commit ไฟล์ .env จริงขึ้น Git เด็ดขาด!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Alpaca Trading API Configuration (Paper Trading by default)
# สิทธิ์ API Key ต้องเป็น "Trade Only" (ห้ามมีสิทธิ์ Withdraw เด็ดขาด)
# ------------------------------------------------------------------------------
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_ID
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
TRADING_MODE=paper

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algo_trading
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# 3. Notification Configuration (Telegram Bot)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=false

# ------------------------------------------------------------------------------
# 4. AI Gatekeeper (OpenRouter API) — For Phase 3
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5. Risk Management & Hard Limits
# ------------------------------------------------------------------------------
INITIAL_CAPITAL_USD=700.0
MAX_DAILY_LOSS_USD=14.0
MAX_POSITION_SIZE_USD=140.0
TRADE_BUDGET_PER_TRANCHE_USD=20.0
MAX_CONCURRENT_POSITIONS=3
TARGET_SYMBOLS=NVDA,TSM

# ------------------------------------------------------------------------------
# 6. System & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development
